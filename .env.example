# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave empty to block all CORS requests)
ALLOWED_ORIGINS=http://localhost:3000,https://medicore.example.com

# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── API Gateway ────────────────────────────────────────────────────────────
API_GATEWAY_PORT=3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_secret_key_at_least_64_chars
JWT_REFRESH_SECRET=change_this_to_another_very_long_random_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Auth Service ────────────────────────────────────────────────────────────
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_URL=http://auth-service:3001

# ─── User Service ────────────────────────────────────────────────────────────
USER_SERVICE_PORT=3002
USER_SERVICE_URL=http://user-service:3002

# ─── Inventory Service ──────────────────────────────────────────────────────
INVENTORY_SERVICE_PORT=3003
INVENTORY_SERVICE_URL=http://inventory-service:3003

# ─── Billing Service ────────────────────────────────────────────────────────
BILLING_SERVICE_PORT=3004
BILLING_SERVICE_URL=http://billing-service:3004

# ─── Purchase Service ───────────────────────────────────────────────────────
PURCHASE_SERVICE_PORT=3005
PURCHASE_SERVICE_URL=http://purchase-service:3005

# ─── Analytics Service ──────────────────────────────────────────────────────
ANALYTICS_SERVICE_PORT=3006
ANALYTICS_SERVICE_URL=http://analytics-service:3006

# ─── AI Assistant Service ───────────────────────────────────────────────────
AI_SERVICE_PORT=3007
AI_SERVICE_URL=http://ai-assistant-service:3007
OPENAI_API_KEY=your_openai_api_key_here

# ─── Notification Service ───────────────────────────────────────────────────
NOTIFICATION_SERVICE_PORT=3008
NOTIFICATION_SERVICE_URL=http://notification-service:3008
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@medicore.com
SMTP_PASS=smtp_password_here
SMS_API_KEY=your_sms_api_key_here
SMS_API_URL=https://api.sms-provider.com

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=medicore
POSTGRES_PASSWORD=medicore_secure_password
POSTGRES_DB=medicore

# Database URLs per service (separate schemas)
AUTH_DB_URL=postgresql://medicore:medicore_secure_password@postgres:5432/medicore_auth
USER_DB_URL=postgresql://medicore:medicore_secure_password@postgres:5432/medicore_users
INVENTORY_DB_URL=postgresql://medicore:medicore_secure_password@postgres:5432/medicore_inventory
BILLING_DB_URL=postgresql://medicore:medicore_secure_password@postgres:5432/medicore_billing
PURCHASE_DB_URL=postgresql://medicore:medicore_secure_password@postgres:5432/medicore_purchase
ANALYTICS_DB_URL=postgresql://medicore:medicore_secure_password@postgres:5432/medicore_analytics

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_URL=redis://:redis_secure_password@redis:6379

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=medicore
RABBITMQ_PASSWORD=rabbitmq_secure_password
RABBITMQ_URL=amqp://medicore:rabbitmq_secure_password@rabbitmq:5672

# ─── Branches ────────────────────────────────────────────────────────────────
TOTAL_BRANCHES=18
