{
  "name": "@medicore/distribution",
  "version": "1.0.0",
  "description": "MediCore Distribution – Production-Grade Pharmacy Operations Platform",
  "private": true,
  "scripts": {
    "test": "jest --testPathPattern=tests/ --forceExit",
    "test:coverage": "jest --testPathPattern=tests/ --coverage --forceExit",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
